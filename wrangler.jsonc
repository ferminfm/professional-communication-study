{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "professional-communication-study",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brand-study-db",
      "database_id": "bf4223a1-21b7-4cfb-83c7-e53112f9f5fb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "STUDY_VERSION": "2026-09-23.v1"
  }
}
